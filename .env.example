# ============================================
#   Sansa Bot — .env.example
#   Copy this file to .env and fill in your values
# ============================================

# ── Required ───────────────────────────────
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ── Channel IDs (Discord Channel IDs) ──────
# Main chat channel (most commands work only here)
CHAT_CHANNEL_ID=0

# SFW Channels
WAIFU_CHANNEL_ID=0          # #waifu-zone
ANIME_CHANNEL_ID=0          # #anime-zone
MANGA_CHANNEL_ID=0          # #manga-zone
MEMES_CHANNEL_ID=0          # #memes-zone

# NSFW Channels (special commands + auto posts)
HANIME_CHANNEL_ID=0         # #hanime
HDAD_CHANNEL_ID=0           # #hdad (hentaidad.com)
SAKUH_CHANNEL_ID=0          # #sakuh (sakuhentai.net)
LUCI_CHANNEL_ID=0           # #luci (lucioushentai.com)

# Save channel for ❤️ reactions
SAVE_CHANNEL_ID=0           # #save

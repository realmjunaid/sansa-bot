# ============================================
#   Sansa Bot — .env.example
#   Copy this file to .env and fill in your values
# ============================================

# ── Required ───────────────────────────────
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# MyAnimeList API Client ID (https://myanimelist.net/apiconfig)
# Free — create app, copy Client ID. Used for /anime /manga /top /season + auto posts
MAL_CLIENT_ID=YOUR_MAL_CLIENT_ID_HERE

# ── Channel IDs (Discord Channel IDs) ──────
# Main chat channel (most commands work only here)
CHAT_CHANNEL_ID=0

# SFW Channels
ANIME_CHANNEL_ID=0          # #anime-zone
MANGA_CHANNEL_ID=0          # #manga-zone
MEMES_CHANNEL_ID=0          # #memes-zone

# Save channel for ❤️ reactions
SAVE_CHANNEL_ID=0           # #save
